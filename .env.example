DATABASE_URL=postgresql://drivecore:CHANGE_ME@127.0.0.1:55439/drivecore
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SEED_ADMIN_EMAIL=admin@drivecore.local
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_DEMO_PASSWORD
PORT=4000
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TZ=Europe/Moscow
UPLOAD_DIR=backend/uploads
# Optional integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Docker-only database password (URL-safe)
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
DOCKER_APP_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
# Production session cookies always require HTTPS.
DOCKER_NODE_ENV=development
TRUST_PROXY=0
UPLOAD_MAX_BYTES=1073741824
# Vercel: provision a private Blob store; never prefix its token with VITE_.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
